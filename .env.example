# Copy to .env and adjust. See README.md → Configuration for all options.

# --- required ---------------------------------------------------------------
SECRET_KEY=please-generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=florepo

# public URL (used for npm tarball links, e-mails and setup snippets)
BASE_URL=http://localhost:8080
PORT=8080

# --- performance (defaults are fine for most setups) --------------------------
# WEB_WORKERS=            # default: 2 x CPU cores, max. 16
# WEB_WORKER_CONNECTIONS=1000
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=15
# ACCESS_LOG=true
# PROXY_METADATA_TTL=300

# --- scanner defaults (editable in the UI under Scanner & DB) -----------------
# TRIVY_DB_UPDATE_HOURS=12
# RESCAN_INTERVAL_HOURS=24
# OSV_ENABLED=true

# --- e-mail alerts (rules are configured in the UI under Notifications) -------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=florepo@example.com
# SMTP_SECURITY=starttls   # starttls | ssl | none

# --- outbound HTTP/HTTPS proxy (also editable in the UI under Network) --------
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,.example.com

# --- scan workers -------------------------------------------------------------
# WORKER_REPLICAS=2        # parallel scan workers (each runs one Trivy scan at a time)

# --- artifact storage (README → Storage) --------------------------------------
# STORAGE_BACKEND=fs       # fs = local volume / mounted NFS share, s3 = object store
# NFS: COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml  NFS_SERVER=10.0.0.20  NFS_EXPORT=/export/florepo
# S3_BUCKET=florepo
# S3_ENDPOINT_URL=         # empty = AWS; e.g. https://s3.example.com (MinIO, Ceph, Garage, SeaweedFS, ...)
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# S3_SERVE=proxy           # proxy (nginx streams from S3) | redirect (pre-signed URL) | stream
# bundled SeaweedFS example: COMPOSE_FILE=docker-compose.yml:docker-compose.s3-local.yml

# --- malware scanning (ClamAV, separate container) ----------------------------
# COMPOSE_PROFILES=clamav
# CLAMAV_ENABLED=true      # default for Administration → Scanner & DB → Malware scanning

# --- metadata cache -----------------------------------------------------------
# METADATA_CACHE_MB=32     # rendered package metadata per web worker, 0 = off
